{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dftlab.invalid/contracts/schemas/qraft-controller-ledger-entry.schema.json",
  "title": "QraftControllerLedgerEntry",
  "description": "Una línea del libro de lanzamientos internos qraft.controller-inner-ledger@1.0 (ADR-017 §4 y Adenda 1). Contrato nativo de QRAFT; la plataforma lo valida al importar la evidencia. QRAFT empaqueta una copia idéntica de este schema.",
  "type": "object",
  "required": [
    "contract",
    "seq",
    "event",
    "at",
    "task_id",
    "attempt_id",
    "key"
  ],
  "properties": {
    "contract": {
      "const": "qraft.controller-inner-ledger@1.0"
    },
    "seq": {
      "$ref": "defs.schema.json#/$defs/safe_count",
      "description": "Monótona desde 1 dentro del libro de un intento."
    },
    "event": {
      "enum": [
        "LAUNCH_INTENT",
        "LAUNCH_STARTED",
        "LAUNCH_FINISHED",
        "LAUNCH_ABANDONED",
        "NODE_SETTLED",
        "SETTLEMENT_RECOVERED"
      ]
    },
    "at": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "key": {
      "type": "object",
      "required": [
        "checkpoint_identity",
        "node_id"
      ],
      "properties": {
        "checkpoint_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Identidad nativa del checkpoint de HubbardFlow (campaign_digest de JsonDagCheckpoint), copiada byte a byte; QRAFT no la recalcula."
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "node_id nativo del LRDag, copiado byte a byte."
        }
      },
      "additionalProperties": false
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+/[1-9][0-9]*$",
      "description": "<task_id>/<attempt_id>/<seq del LAUNCH_INTENT>. Identifica un lanzamiento concreto; nunca se usa para deduplicar."
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ranks": {
      "$ref": "defs.schema.json#/$defs/safe_count"
    },
    "cpus_per_rank": {
      "$ref": "defs.schema.json#/$defs/safe_count"
    },
    "argv_sha256": {
      "$ref": "defs.schema.json#/$defs/sha256_hex"
    },
    "pid": {
      "$ref": "defs.schema.json#/$defs/safe_count"
    },
    "exit_code": {
      "type": "integer",
      "minimum": -255,
      "maximum": 255
    },
    "reason": {
      "$ref": "defs.schema.json#/$defs/code"
    },
    "native_state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "NodeState nativo de HubbardFlow tal cual (vocabulario abierto)."
    },
    "evidence_digest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "source_attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "LAUNCH_INTENT"
          }
        }
      },
      "then": {
        "required": [
          "trace_id",
          "hosts",
          "ranks",
          "cpus_per_rank",
          "argv_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "LAUNCH_STARTED"
          }
        }
      },
      "then": {
        "required": [
          "trace_id",
          "pid"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "LAUNCH_FINISHED"
          }
        }
      },
      "then": {
        "required": [
          "trace_id",
          "exit_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "LAUNCH_ABANDONED"
          }
        }
      },
      "then": {
        "required": [
          "trace_id",
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "NODE_SETTLED"
          }
        }
      },
      "then": {
        "required": [
          "trace_id",
          "native_state",
          "evidence_digest"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "SETTLEMENT_RECOVERED"
          }
        }
      },
      "then": {
        "required": [
          "native_state",
          "evidence_digest",
          "source_attempt_id"
        ],
        "not": {
          "required": [
            "trace_id"
          ]
        }
      }
    }
  ]
}
