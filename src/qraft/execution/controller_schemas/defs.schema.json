{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dftlab.invalid/contracts/schemas/defs.schema.json",
  "title": "Definiciones comunes",
  "description": "Tipos compartidos por todos los schemas de plataforma (ADR-004 §5).",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "Identificador opaco. No es una ruta del host."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "namespaced_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "safe_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "description": "Decimal exacto o token impreso para certificación; no se convierte a float."
    },
    "big_int_string": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "description": "Entero fuera del rango seguro de JS."
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[^\\\\\\u0000]{1,1024}$",
      "description": "Ruta relativa dentro de un paquete o bundle; sin '..', sin raíz ni unidad."
    },
    "absent_reason": {
      "enum": [
        "NOT_COMPUTED",
        "NOT_APPLICABLE",
        "NOT_AVAILABLE",
        "PARSE_FAILED",
        "REDACTED",
        "NOT_ESTABLISHED",
        "UNKNOWN"
      ]
    },
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "absent_reason": {
          "$ref": "#/$defs/absent_reason"
        }
      },
      "if": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "absent_reason"
        ]
      },
      "description": "Ausente = null + motivo, nunca cero."
    },
    "producer": {
      "type": "object",
      "required": [
        "package",
        "version"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/git_commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithm": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "native_status": {
      "type": "object",
      "required": [
        "authority",
        "vocabulary",
        "value"
      ],
      "properties": {
        "authority": {
          "enum": [
            "qraft",
            "hubbardflow",
            "siesta-adapter"
          ]
        },
        "vocabulary": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "value": {
          "$ref": "#/$defs/code"
        }
      },
      "additionalProperties": false,
      "description": "Valor nativo transportado sin traducir. Vocabulario abierto: un valor desconocido valida, pero nunca se proyecta como PASS (vocabularies/native-status-projection.json)."
    },
    "passport_state": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE",
        "NOT_ESTABLISHED"
      ]
    },
    "policy_ref": {
      "type": "object",
      "required": [
        "policy_id",
        "version",
        "digest"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/namespaced_id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "digest": {
          "$ref": "#/$defs/sha256_hex"
        }
      },
      "additionalProperties": false
    },
    "native_digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/namespaced_id"
        },
        "value": {
          "$ref": "#/$defs/sha256_hex"
        }
      },
      "additionalProperties": false,
      "description": "Digest con el algoritmo original del motor (vocabularies/native-digest-algorithms.json); la plataforma no lo recalcula."
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "purpose",
        "provenance_state",
        "scientific_assessment"
      ],
      "properties": {
        "origin": {
          "enum": [
            "BUILTIN_EXAMPLE",
            "DIDACTIC_SIMULATION",
            "USER_IMPORT",
            "TRACKED_RUN"
          ]
        },
        "purpose": {
          "enum": [
            "EDUCATIONAL",
            "EXPLORATORY",
            "OPERATIONAL"
          ]
        },
        "provenance_state": {
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "provenance_evidence": {
          "type": "array",
          "items": {
            "$ref": "artifact-ref.schema.json"
          }
        },
        "scientific_assessment": {
          "type": "object",
          "required": [
            "state",
            "assessment_refs"
          ],
          "properties": {
            "state": {
              "anyOf": [
                {
                  "$ref": "#/$defs/passport_state"
                },
                {
                  "const": "NOT_EVALUATED"
                }
              ]
            },
            "assessment_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "USER_IMPORT"
              },
              "provenance_state": {
                "const": "VERIFIED"
              }
            }
          },
          "then": {
            "required": [
              "provenance_evidence"
            ],
            "properties": {
              "provenance_evidence": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "description": "ADR-002: cuatro campos independientes; ninguno se deriva de otro."
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "engine_pin": {
      "type": "object",
      "required": [
        "engine",
        "distribution",
        "version"
      ],
      "properties": {
        "engine": {
          "enum": [
            "qraft",
            "hubbardflow",
            "siesta"
          ]
        },
        "distribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/git_commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "distribution_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256_hex"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "anyOf": [
        {
          "$ref": "artifact-ref.schema.json"
        },
        {
          "$ref": "native-contract-ref.schema.json"
        }
      ]
    }
  }
}
