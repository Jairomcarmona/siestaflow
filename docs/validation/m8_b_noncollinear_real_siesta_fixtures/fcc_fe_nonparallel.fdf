 1 + 90.0 0.0
 2 + 90.0 90.0
%endblock DM.InitSpin
Charge.Mulliken end
%block kgrid.MonkhorstPack
 3 0 0 0.0
 0 3 0 0.0
 0 0 3 0.0
%endblock kgrid.MonkhorstPack
MD.TypeOfRun CG
MD.VariableCell false
